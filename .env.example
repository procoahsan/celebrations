# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase access (validated public form writes, integrations)
SUPABASE_SERVICE_ROLE_KEY=

# Notifications (Resend; the from-domain must be verified in Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Google Calendar / Meet (OAuth web client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered in Google Cloud: <site>/api/admin/google/callback
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=primary
# Any long random string; encrypts OAuth tokens at rest (AES-256-GCM)
OAUTH_TOKEN_ENCRYPTION_KEY=

# Instagram via Meta Graph API (Facebook Login; Instagram professional account linked to a Page)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
INSTAGRAM_VERIFY_TOKEN=

DEFAULT_TIMEZONE=America/Chicago
